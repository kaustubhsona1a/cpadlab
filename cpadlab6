                          <Text style={styles.arrowButtonText}>↗</Text>
                        </TouchableOpacity>
                      </View>
                    </View>
                  </View>
                );
              })}
            </View>
          ) : (
            <View style={styles.emptyState}>
              <Text style={styles.emptyIcon}>⌕</Text>
              <Text style={styles.emptyTitle}>No cars found</Text>
              <Text style={styles.emptyDescription}>
                Try another search or change your selected filter.
              </Text>
              <TouchableOpacity
                style={styles.resetButton}
                onPress={() => {
                  setSearch('');
                  setActiveFilter('All Cars');
                  setActiveTab('Inventory');
                }}
              >
                <Text style={styles.resetButtonText}>RESET FILTERS</Text>
              </TouchableOpacity>
            </View>
          )}

          {/* Sell your car banner */}
          {activeTab !== 'Saved' && (
            <View style={styles.sellBanner}>
              <View style={styles.sellCopy}>
                <Text style={styles.sellEyebrow}>READY FOR AN UPGRADE?</Text>
                <Text style={styles.sellTitle}>Your car deserves{'\n'}a better deal.</Text>
                <Text style={styles.sellDescription}>
                  Sell with confidence. Let our team help.
                </Text>

                <TouchableOpacity
                  style={styles.sellButton}
                  onPress={() =>
                    setNotice(
                      'Thanks for your interest! Visit our Mumbai showroom or contact our team to sell your car.',
                    )
                  }
                >
                  <Text style={styles.sellButtonText}>SELL YOUR CAR ↗</Text>
                </TouchableOpacity>
              </View>

              <Text style={styles.sellDecoration}>C</Text>
            </View>
          )}

          {/* Notice */}
          {notice !== '' && (
            <View style={styles.noticeBox}>
              <Text style={styles.noticeText}>{notice}</Text>
              <TouchableOpacity onPress={() => setNotice('')}>
                <Text style={styles.noticeClose}>✕</Text>
              </TouchableOpacity>
            </View>
          )}

          {/* Footer */}
          <View style={styles.footer}>
            <Text style={styles.footerBrand}>CARTRONICS</Text>
            <Text style={styles.footerText}>BUY & SELL QUALITY CARS</Text>
            <Text style={styles.footerCopyright}>
              © 2026 CARTRONICS • MUMBAI
            </Text>
          </View>
        </ScrollView>

        {/* Bottom navigation */}
        <View style={styles.bottomNav}>
          {[
            { label: 'Home', icon: '⌂' },
            { label: 'Inventory', icon: '▦' },
            { label: 'Saved', icon: '♡' },
            { label: 'Profile', icon: '◉' },
          ].map((item) => {
            const active = activeTab === item.label;

            return (
              <TouchableOpacity
                key={item.label}
                style={styles.navItem}
                onPress={() => handleTab(item.label)}
                activeOpacity={0.75}
              >
                <Text style={[styles.navIcon, active && styles.navIconActive]}>
                  {item.icon}
                </Text>
                <Text style={[styles.navLabel, active && styles.navLabelActive]}>
                  {item.label}
                </Text>
                {active && <View style={styles.navIndicator} />}
              </TouchableOpacity>
            );
          })}
        </View>
      </View>

      {/* Vehicle detail modal */}
      <Modal
        visible={selectedCar !== null}
        transparent
        animationType="slide"
        onRequestClose={() => setSelectedCar(null)}
      >
        <View style={styles.modalBackdrop}>
          <View style={styles.modalCard}>
            <View style={styles.modalHandle} />

            {selectedCar && (
              <>
                <ImageBackground
                  source={{ uri: selectedCar.image }}
                  style={styles.modalImage}
                  imageStyle={styles.modalImageRadius}
                >
                  <TouchableOpacity
                    style={styles.modalClose}
                    onPress={() => setSelectedCar(null)}
                  >
                    <Text style={styles.modalCloseText}>✕</Text>
                  </TouchableOpacity>
                  <View style={styles.modalImageTag}>
                    <Text style={styles.carBadgeText}>{selectedCar.badge}</Text>
                  </View>
                </ImageBackground>

                <View style={styles.modalContent}>
                  <Text style={styles.modalEyebrow}>CARTRONICS COLLECTION</Text>
                  <Text style={styles.modalTitle}>{selectedCar.name}</Text>
                  <Text style={styles.modalVariant}>{selectedCar.variant}</Text>
                  <Text style={styles.modalPrice}>
                    {formatPrice(selectedCar.price)}
                  </Text>

                  <View style={styles.modalSpecs}>
                    <View style={styles.modalSpec}>
                      <Text style={styles.modalSpecLabel}>YEAR</Text>
                      <Text style={styles.modalSpecValue}>{selectedCar.year}</Text>
                    </View>
                    <View style={styles.modalSpec}>
                      <Text style={styles.modalSpecLabel}>KILOMETRES</Text>
                      <Text style={styles.modalSpecValue}>{selectedCar.km}</Text>
                    </View>
                    <View style={styles.modalSpec}>
                      <Text style={styles.modalSpecLabel}>FUEL</Text>
                      <Text style={styles.modalSpecValue}>{selectedCar.fuel}</Text>
                    </View>
                  </View>

                  <Text style={styles.modalDescription}>
                    {selectedCar.description}
                  </Text>

                  <View style={styles.modalActions}>
                    <TouchableOpacity
                      style={styles.modalPrimary}
                      onPress={() => {
                        setSelectedCar(null);
                        setNotice(
                          `Enquiry started for ${selectedCar.name}. Our team will help you with the next steps.`,
                        );
                      }}
                    >
                      <Text style={styles.modalPrimaryText}>ENQUIRE NOW ↗</Text>
                    </TouchableOpacity>

                    <TouchableOpacity
                      style={styles.modalSave}
                      onPress={() => toggleSaved(selectedCar.id)}
                    >
                      <Text style={styles.modalSaveText}>
                        {savedIds.includes(selectedCar.id) ? '♥ SAVED' : '♡ SAVE'}
                      </Text>
                    </TouchableOpacity>
                  </View>
                </View>
              </>
            )}
          </View>
        </View>
      </Modal>
    </SafeAreaView>
  );
}

