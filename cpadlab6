            <View>
              <Text style={styles.sectionEyebrow}>THE CARTRONICS EDIT</Text>
              <Text style={styles.sectionTitle}>{sectionTitle}</Text>
            </View>

            <TouchableOpacity onPress={() => handleTab('Inventory')}>
              <Text style={styles.viewAll}>VIEW ALL ↗</Text>
            </TouchableOpacity>
          </View>

          {/* Filters */}
          <ScrollView
            horizontal
            showsHorizontalScrollIndicator={false}
            contentContainerStyle={styles.filterRow}
          >
            {FILTERS.map((filter) => {
              const selected = activeFilter === filter;

              return (
                <TouchableOpacity
                  key={filter}
                  onPress={() => setActiveFilter(filter)}
                  style={[styles.filterChip, selected && styles.filterChipActive]}
                >
                  <Text
                    style={[
                      styles.filterText,
                      selected && styles.filterTextActive,
                    ]}
                  >
                    {filter}
                  </Text>
                </TouchableOpacity>
              );
            })}
          </ScrollView>

          <Text style={styles.resultCount}>
            {filteredCars.length} VEHICLE{filteredCars.length === 1 ? '' : 'S'} FOUND
          </Text>

          {/* Vehicle cards */}
          {filteredCars.length > 0 ? (
            <View style={styles.vehicleGrid}>
              {filteredCars.map((car) => {
                const saved = savedIds.includes(car.id);

                return (
                  <View key={car.id} style={styles.carCard}>
                    <TouchableOpacity
                      activeOpacity={0.9}
                      onPress={() => setSelectedCar(car)}
                    >
                      <ImageBackground
                        source={{ uri: car.image }}
                        style={styles.carImage}
                        imageStyle={styles.carImageRadius}
                      >
                        <View style={styles.carImageShade} />

                        <View style={styles.carBadge}>
                          <Text style={styles.carBadgeText}>{car.badge}</Text>
                        </View>
                      </ImageBackground>
                    </TouchableOpacity>

                    <TouchableOpacity
                      style={styles.heartButton}
                      onPress={() => toggleSaved(car.id)}
                      activeOpacity={0.8}
                    >
                      <Text
                        style={[
                          styles.heartText,
                          saved && styles.heartTextActive,
                        ]}
                      >
                        {saved ? '♥' : '♡'}
                      </Text>
                    </TouchableOpacity>

                    <View style={styles.carInfo}>
                      <View style={styles.carTitleRow}>
                        <Text style={styles.carName}>{car.name}</Text>
                        <Text style={styles.carYear}>{car.year}</Text>
                      </View>

                      <Text style={styles.carVariant}>{car.variant}</Text>

                      <View style={styles.carSpecs}>
                        <Text style={styles.specText}>{car.km}</Text>
                        <View style={styles.specDot} />
                        <Text style={styles.specText}>{car.fuel}</Text>
                        <View style={styles.specDot} />
                        <Text style={styles.specText}>{car.transmission}</Text>
                      </View>

                      <View style={styles.carCardFooter}>
                        <View>
                          <Text style={styles.priceLabel}>OUR PRICE</Text>
                          <Text style={styles.carPrice}>
                            {formatPrice(car.price)}
                          </Text>
                        </View>

                        <TouchableOpacity
                          style={styles.arrowButton}
                          onPress={() => setSelectedCar(car)}
