const FILTERS = ['All Cars', 'Luxury', 'Sports', 'Sedan'];

const formatPrice = (price: number) => {
  if (price >= 10000000) {
    return `₹${(price / 10000000).toFixed(2).replace(/\.00$/, '')} Cr`;
  }
  return `₹${(price / 100000).toFixed(1).replace(/\.0$/, '')} L`;
};

export default function HomeScreen() {
  const [activeTab, setActiveTab] = useState('Home');
  const [activeFilter, setActiveFilter] = useState('All Cars');
  const [search, setSearch] = useState('');
  const [savedIds, setSavedIds] = useState<string[]>([]);
  const [selectedCar, setSelectedCar] = useState<(typeof CARS)[number] | null>(
    null,
  );
  const [notice, setNotice] = useState('');

  const filteredCars = useMemo(() => {
    let result = CARS;

    if (activeTab === 'Saved') {
      result = result.filter((car) => savedIds.includes(car.id));
    }

    if (activeFilter !== 'All Cars') {
      result = result.filter((car) => car.category === activeFilter);
    }

    const query = search.trim().toLowerCase();

    if (query) {
      result = result.filter(
        (car) =>
          car.name.toLowerCase().includes(query) ||
          car.variant.toLowerCase().includes(query) ||
          car.fuel.toLowerCase().includes(query),
      );
    }

    return result;
  }, [activeFilter, activeTab, savedIds, search]);

  const toggleSaved = (id: string) => {
    setSavedIds((previous) =>
      previous.includes(id)
        ? previous.filter((savedId) => savedId !== id)
        : [...previous, id],
    );
  };

  const handleTab = (tab: string) => {
    setActiveTab(tab);
    setNotice('');

    if (tab === 'Inventory' || tab === 'Home') {
      setActiveFilter('All Cars');
    }

    if (tab === 'Profile') {
      setNotice('Welcome to Cartronics. Contact our team to get started.');
    }
  };

  const sectionTitle =
    activeTab === 'Saved'
      ? 'Your Shortlist'
      : activeTab === 'Inventory'
        ? 'Explore Inventory'
        : activeTab === 'Profile'
          ? 'Your Car Journey'
          : 'Curated For You';

  return (
    <SafeAreaView style={styles.safeArea}>
      <StatusBar barStyle="light-content" backgroundColor={COLORS.background} />

      <View style={styles.app}>
        {/* Header */}
        <View style={styles.header}>
          <TouchableOpacity
            style={styles.brand}
            activeOpacity={0.8}
            onPress={() => handleTab('Home')}
          >
            <View style={styles.brandMark}>
              <Text style={styles.brandMarkText}>C</Text>
            </View>

            <View>
              <Text style={styles.brandName}>CARTRONICS</Text>
              <Text style={styles.brandSubtitle}>PRE-OWNED. REDEFINED.</Text>
            </View>
          </TouchableOpacity>

          <TouchableOpacity
            style={styles.headerIcon}
            onPress={() =>
              setNotice('You are all caught up. No new notifications.')
            }
          >
            <Text style={styles.headerIconText}>♧</Text>
            <View style={styles.notificationDot} />
          </TouchableOpacity>
        </View>

        <ScrollView
          style={styles.scroll}
          contentContainerStyle={styles.scrollContent}
          showsVerticalScrollIndicator={false}
        >
          {/* Hero */}
          {activeTab === 'Home' && (
            <>
              <ImageBackground
                source={{ uri: HERO_IMAGE }}
                style={styles.hero}
                imageStyle={styles.heroImage}
              >
                <View style={styles.heroOverlay} />

                <View style={styles.heroContent}>
                  <View style={styles.heroEyebrow}>
                    <View style={styles.redDot} />
                    <Text style={styles.heroEyebrowText}>
                      THE ART OF DRIVING
                    </Text>
                  </View>

                  <Text style={styles.heroTitle}>
                    Find your{'\n'}next <Text style={styles.heroAccent}>drive.</Text>
                  </Text>

                  <Text style={styles.heroDescription}>
                    Exceptional cars. Carefully selected.
                    {'\n'}Confidence in every kilometre.
                  </Text>

                  <TouchableOpacity
                    style={styles.heroButton}
                    onPress={() => handleTab('Inventory')}
                    activeOpacity={0.85}
                  >
                    <Text style={styles.heroButtonText}>EXPLORE COLLECTION</Text>
                    <Text style={styles.heroButtonArrow}>↗</Text>
                  </TouchableOpacity>
                </View>

                <View style={styles.heroCounter}>
                  <Text style={styles.heroCounterNumber}>01</Text>
                  <View style={styles.heroCounterLine} />
                  <Text style={styles.heroCounterTotal}>04</Text>
                </View>
              </ImageBackground>

              {/* Trust stats */}
              <View style={styles.statsRow}>
                <View style={styles.stat}>
                  <Text style={styles.statNumber}>100%</Text>
                  <Text style={styles.statLabel}>TRANSPARENCY</Text>
                </View>
                <View style={styles.statDivider} />
                <View style={styles.stat}>
                  <Text style={styles.statNumber}>SELECT</Text>
                  <Text style={styles.statLabel}>QUALITY CARS</Text>
                </View>
                <View style={styles.statDivider} />
                <View style={styles.stat}>
                  <Text style={styles.statNumber}>MUMBAI</Text>
                  <Text style={styles.statLabel}>OUR HOME</Text>
                </View>
              </View>
            </>
          )}

          {/* Search */}
          <View style={styles.searchBox}>
            <Text style={styles.searchIcon}>⌕</Text>
            <TextInput
              value={search}
              onChangeText={setSearch}
              placeholder="Search make, model or fuel..."
              placeholderTextColor={COLORS.muted}
              style={styles.searchInput}
              returnKeyType="search"
              autoCapitalize="none"
            />
            {search.length > 0 && (
              <TouchableOpacity onPress={() => setSearch('')}>
                <Text style={styles.clearSearch}>✕</Text>
              </TouchableOpacity>
            )}
          </View>

          {/* Inventory section */}
