}

// -------------------- ADD TRANSACTION FORM --------------------

type AddFormProps = {
  onAdd: (
    title: string,
    amount: number,
    type: TransactionType,
    category: string,
  ) => void;
};

function AddForm({ onAdd }: AddFormProps) {
  const [title, setTitle] = useState('');
  const [amount, setAmount] = useState('');
  const [type, setType] = useState<TransactionType>('Expense');
  const [category, setCategory] = useState('Food');

  const submit = () => {
    const cleanTitle = title.trim();
    const parsedAmount = Number(amount);

    if (
      cleanTitle.length === 0 ||
      amount.trim() === '' ||
      !Number.isFinite(parsedAmount) ||
      parsedAmount <= 0
    ) {
      Alert.alert(
        'Invalid input',
        'Please enter a transaction title and a valid amount greater than zero.',
      );
      return;
    }

    onAdd(cleanTitle, parsedAmount, type, category);

    setTitle('');
    setAmount('');
    setType('Expense');
    setCategory('Food');
  };

  return (
    <View style={styles.formCard}>
      <View style={styles.sectionHeadingRow}>
        <View>
          <Text style={styles.eyebrow}>TRANSACTION DETAILS</Text>
          <Text style={styles.sectionTitle}>Add a transaction</Text>
        </View>

        <View style={styles.stepBadge}>
          <Text style={styles.stepBadgeText}>NEW</Text>
        </View>
      </View>

      <Text style={styles.fieldLabel}>TRANSACTION TYPE</Text>

      <View style={styles.typeSelector}>
        {(['Expense', 'Income'] as TransactionType[]).map((item) => {
          const selected = type === item;
          const isIncome = item === 'Income';

          return (
            <TouchableOpacity
              key={item}
              onPress={() => {
                setType(item);
                setCategory(isIncome ? 'Salary' : 'Food');
              }}
              style={[
                styles.typeButton,
                selected &&
                  (isIncome
                    ? styles.incomeTypeSelected
                    : styles.expenseTypeSelected),
              ]}
            >
              <Text
                style={[
                  styles.typeButtonText,
                  selected && styles.typeButtonTextSelected,
                ]}
              >
                {isIncome ? '+  Income' : '−  Expense'}
              </Text>
            </TouchableOpacity>
          );
        })}
      </View>

      <Text style={styles.fieldLabel}>TRANSACTION TITLE</Text>

      <TextInput
        value={title}
        onChangeText={setTitle}
        placeholder="e.g. Monthly salary, Lunch"
        placeholderTextColor={COLORS.muted}
        style={styles.input}
        maxLength={60}
        returnKeyType="next"
      />

      <Text style={styles.fieldLabel}>AMOUNT (₹)</Text>

      <View style={styles.amountInputContainer}>
        <Text style={styles.rupeePrefix}>₹</Text>
        <TextInput
          value={amount}
          onChangeText={(value) =>
            setAmount(value.replace(/[^0-9.]/g, ''))
          }
          placeholder="0.00"
          placeholderTextColor={COLORS.muted}
          keyboardType="decimal-pad"
          style={styles.amountInput}
        />
      </View>

      <Text style={styles.fieldLabel}>SELECT CATEGORY</Text>

      <View style={styles.categoryWrap}>
        {CATEGORIES.filter((item) =>
          type === 'Income'
            ? ['Salary', 'Other'].includes(item)
            : item !== 'Salary',
        ).map((item) => (
          <CategoryChip
            key={item}
            label={item}
            selected={category === item}
            onPress={() => setCategory(item)}
          />
        ))}
      </View>

      <TouchableOpacity
        style={styles.addButton}
        onPress={submit}
        activeOpacity={0.8}
      >
        <Text style={styles.addButtonText}>+  Add Transaction</Text>
      </TouchableOpacity>

      <Text style={styles.formHint}>
        Your summary updates automatically after each transaction.
      </Text>
    </View>
  );
}

// -------------------- TRANSACTION ITEM --------------------

type TransactionItemProps = {
  item: Transaction;
  onDelete: (id: string) => void;
};

function TransactionItem({
  item,
  onDelete,
}: TransactionItemProps) {
  const isIncome = item.type === 'Income';

  return (
    <View style={styles.transactionItem}>
      <View
        style={[
          styles.transactionIcon,
          {
            backgroundColor: isIncome
              ? COLORS.greenDark
              : COLORS.redDark,
          },
        ]}
      >
        <Text
          style={[
            styles.transactionIconText,
            { color: isIncome ? COLORS.green : COLORS.red },
          ]}
        >
          {isIncome ? '↙' : '↗'}
        </Text>
      </View>

      <View style={styles.transactionDetails}>
        <Text style={styles.transactionTitle} numberOfLines={1}>
          {item.title}
        </Text>
        <Text style={styles.transactionMeta}>
          {item.category}  ·  {item.date}
        </Text>
      </View>

      <View style={styles.transactionRight}>
        <Text
          style={[
            styles.transactionAmount,
            { color: isIncome ? COLORS.green : COLORS.red },
          ]}
        >
          {isIncome ? '+' : '−'}{formatMoney(item.amount)}
        </Text>
        <Text style={styles.transactionType}>{item.type}</Text>
      </View>

      <TouchableOpacity
        onPress={() =>
          Alert.alert(
            'Delete transaction?',
            `Remove "${item.title}" from your records?`,
            [
              { text: 'Cancel', style: 'cancel' },
              {
                text: 'Delete',
                style: 'destructive',
                onPress: () => onDelete(item.id),
              },
            ],
          )
        }
        style={styles.deleteButton}
        accessibilityLabel={`Delete ${item.title}`}
      >
        <Text style={styles.deleteButtonText}>×</Text>
      </TouchableOpacity>
    </View>
  );
}

// -------------------- MAIN APPLICATION --------------------

export default function Index() {
  const [transactions, setTransactions] = useState<Transaction[]>([]);
  const [activeTab, setActiveTab] = useState<'All' | TransactionType>('All');

  const income = useMemo(
    () =>
      transactions
        .filter((item) => item.type === 'Income')
        .reduce((total, item) => total + item.amount, 0),
    [transactions],
  );

  const expense = useMemo(
    () =>
      transactions
        .filter((item) => item.type === 'Expense')
        .reduce((total, item) => total + item.amount, 0),
    [transactions],
  );

  const balance = income - expense;

  const addTransaction = (
    title: string,
    amount: number,
    type: TransactionType,
    category: string,
  ) => {
    const newTransaction: Transaction = {
      id: `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
      title,
      amount,
      type,
      category,
      date: today(),
    };

    setTransactions((previous) => [newTransaction, ...previous]);
    setActiveTab('All');
  };

  const deleteTransaction = (id: string) => {
    setTransactions((previous) =>
      previous.filter((item) => item.id !== id),
    );
  };

  const visibleTransactions = useMemo(
    () =>
      activeTab === 'All'
        ? transactions
        : transactions.filter((item) => item.type === activeTab),
    [transactions, activeTab],
  );

  return (
    <SafeAreaView style={styles.safeArea}>
      <StatusBar
        barStyle="light-content"
        backgroundColor={COLORS.background}
      />

      <KeyboardAvoidingView
        style={styles.flex}
        behavior={Platform.OS === 'ios' ? 'padding' : undefined}
      >
        <FlatList
          data={visibleTransactions}
          keyExtractor={(item) => item.id}
          keyboardShouldPersistTaps="handled"
          showsVerticalScrollIndicator={false}
          contentContainerStyle={styles.listContent}
          ListHeaderComponent={
            <View>
              {/* Header */}
              <View style={styles.header}>
                <View style={styles.brandRow}>
                  <View style={styles.brandIcon}>
                    <Text style={styles.brandIconText}>₹</Text>
                  </View>
                  <View>
                    <Text style={styles.brandTitle}>MONETRA</Text>
                    <Text style={styles.brandSubtitle}>
                      PERSONAL FINANCE
                    </Text>
                  </View>
                </View>

                <View style={styles.avatar}>
                  <Text style={styles.avatarText}>K</Text>
                </View>
              </View>

              {/* Introduction */}
              <View style={styles.intro}>
                <Text style={styles.greeting}>YOUR MONEY, IN CONTROL</Text>
                <Text style={styles.pageTitle}>Expense Manager</Text>
                <Text style={styles.pageSubtitle}>
                  Track your spending. Build better habits.
                </Text>
              </View>

              {/* Financial Summary */}
              <SummaryCard
                balance={balance}
                income={income}
                expense={expense}
              />

              {/* Transaction Form */}
              <AddForm onAdd={addTransaction} />

              {/* Transaction List Heading */}
              <View style={styles.listHeading}>
                <View>
                  <Text style={styles.eyebrow}>YOUR ACTIVITY</Text>
                  <Text style={styles.sectionTitle}>Transactions</Text>
                </View>

                <View style={styles.countBadge}>
                  <Text style={styles.countBadgeText}>
                    {visibleTransactions.length}
                  </Text>
                </View>
              </View>

              {/* Transaction Filters */}
              <View style={styles.transactionFilters}>
                {(['All', 'Income', 'Expense'] as const).map((tab) => (
                  <TouchableOpacity
                    key={tab}
                    onPress={() => setActiveTab(tab)}
                    style={[
                      styles.transactionFilter,
                      activeTab === tab && styles.transactionFilterActive,
                    ]}
                  >
                    <Text
                      style={[
                        styles.transactionFilterText,
                        activeTab === tab &&
                          styles.transactionFilterTextActive,
                      ]}
                    >
                      {tab}
                    </Text>
                  </TouchableOpacity>
                ))}
              </View>
            </View>
          }
          renderItem={({ item }) => (
            <TransactionItem
              item={item}
              onDelete={deleteTransaction}
            />
          )}
          ItemSeparatorComponent={() => (
            <View style={styles.listSeparator} />
          )}
          ListEmptyComponent={
            <View style={styles.emptyState}>
              <View style={styles.emptyIcon}>
                <Text style={styles.emptyIconText}>↗</Text>
              </View>
              <Text style={styles.emptyTitle}>
                No transactions yet
              </Text>
              <Text style={styles.emptyDescription}>
                Add your first income or expense above to see your
                financial activity here.
              </Text>
            </View>
          }
          ListFooterComponent={
            <View style={styles.footer}>
              <Text style={styles.footerBrand}>MONETRA</Text>
              <Text style={styles.footerText}>
                SMALL STEPS. SMARTER FINANCES.
              </Text>
            </View>
          }
        />
      </KeyboardAvoidingView>
    </SafeAreaView>
  );
}

