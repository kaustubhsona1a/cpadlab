// -------------------- HELPERS --------------------

const formatMoney = (amount: number) =>
  '₹' + amount.toLocaleString('en-IN', {
    maximumFractionDigits: 2,
  });

const today = () =>
  new Date().toLocaleDateString('en-IN', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });

