  // ==========================================================
  // CATEGORY ICON
  // ==========================================================

  IconData getCategoryIcon(String category) {
    switch (category) {
      case 'Sedan':
        return Icons.directions_car;
      case 'Sports':
        return Icons.speed;
      case 'SUV':
        return Icons.airport_shuttle;
      case 'Luxury':
        return Icons.star;
      default:
        return Icons.apps;
    }
  }

  // ==========================================================
  // CAR CARD
  // ==========================================================

  Widget carCard(Car car) {
    final isFavorite =
        favorites.contains(car.name);

    return GestureDetector(
      onTap: () {
        openCarDetails(car);
      },
      child: Container(
        decoration: BoxDecoration(
          color: const Color(0xFF171717),
          borderRadius: BorderRadius.circular(22),
        ),
        child: Row(
          children: [

            ClipRRect(
              borderRadius:
                  const BorderRadius.horizontal(
                left: Radius.circular(22),
              ),
              child: Image.network(
                car.image,
                width: 145,
                height: 145,
                fit: BoxFit.cover,
                errorBuilder:
                    (context, error, stackTrace) {
                  return Container(
                    width: 145,
                    height: 145,
                    color: const Color(0xFF222222),
                    child: const Icon(
                      Icons.directions_car,
                      size: 55,
