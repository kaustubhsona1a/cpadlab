    Car(
      name: 'Porsche 911',
      price: '₹1.45 Crore',
      category: 'Sports',
      year: '2022',
      fuel: 'Petrol',
      image:
          'https://images.unsplash.com/photo-1503736334956-4c8f8e92946d?auto=format&fit=crop&w=900&q=80',
    ),
    Car(
      name: 'Mercedes G63',
      price: '₹2.15 Crore',
      category: 'Luxury',
      year: '2023',
      fuel: 'Petrol',
      image:
          'https://images.unsplash.com/photo-1563720223185-11003d516935?auto=format&fit=crop&w=900&q=80',
