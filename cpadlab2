  // ==========================================================
  // OPEN CAR DETAILS
  // ==========================================================

  void openCarDetails(Car car) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) => CarDetailsPage(
          car: car,
          isFavorite: favorites.contains(car.name),
          onFavoriteChanged: () {
            setState(() {
              if (favorites.contains(car.name)) {
                favorites.remove(car.name);
              } else {
                favorites.add(car.name);
              }
            });
          },
        ),
      ),
    );
  }

